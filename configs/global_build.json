{
  "metadata": {
    "name": "Arch-Builder Master Config",
    "version": "1.0.0",
    "description": "Global manifest for building modular ISOs."
  },
  "defaults": {
    "desktop": "xfce",
    "kernel": "linux",
    "package_profiles": [
      "base",
      "custom-user",
      "xorg"
    ],
    "service_profiles": [
      "common-base"
    ]
  },
  "customizations": {
    "hostname": "arch-builder",
    "timezone": "UTC",
    "locale": "en_US.UTF-8",
    "keymap": "us"
  },
  "system": {
    "workdir_base": "workdir",
    "iso_label": "ARCH-MODERN"
  },
  "boot": {
    "kernel_params": "loglevel=3 quiet splash rd.udev.log_level=3 vt.global_cursor_default=0 nouveau.modeset=1 radeon.modeset=1 i915.modeset=1 nvme_load=yes"
  },
  "system_config": {
    "commands": [
      "echo 'Build finished' > /var/log/build_status.txt",
      "mkdir -p /srv/samba/public",
      "chown nobody:nobody /srv/samba/public",
      "chmod 1777 /srv/samba/public"
    ],
    "files": [
      {
        "src": "configs/custom_files/etc/vconsole.conf",
        "dest": "/etc/vconsole.conf",
        "mode": "0644"
      },
      {
        "src": "configs/custom_files/sudoers.d/99-live-user",
        "dest": "/etc/sudoers.d/99-live-user",
        "mode": "0440"
      }
    ]
  }
}
